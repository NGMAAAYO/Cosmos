diff --git a/nuitka/build/static_src/CosmosModule.c b/nuitka/build/static_src/CosmosModule.c
new file mode 100644
--- /dev/null
+++ b/nuitka/build/static_src/CosmosModule.c
@@ -0,0 +1,91 @@
+#include <Python.h>
+#include <stdint.h>
+
+#if defined(__wasm__)
+__attribute__((import_module("cosmos"), import_name("call")))
+extern int64_t cosmos_host_call(int32_t opcode, int64_t a, int64_t b, int64_t c);
+
+__attribute__((import_module("cosmos"), import_name("call_float")))
+extern double cosmos_host_call_float(int32_t opcode, int64_t a, int64_t b, int64_t c);
+#else
+#error CosmosModule.c is only supported for WebAssembly builds
+#endif
+
+static PyObject *cosmos_call(PyObject *self, PyObject *args) {
+    int opcode;
+    long long a = 0;
+    long long b = 0;
+    long long c = 0;
+
+    (void)self;
+    if (!PyArg_ParseTuple(args, "i|LLL:call", &opcode, &a, &b, &c)) {
+        return NULL;
+    }
+
+    return PyLong_FromLongLong(cosmos_host_call(opcode, a, b, c));
+}
+
+static PyObject *cosmos_call_float(PyObject *self, PyObject *args) {
+    int opcode;
+    long long a = 0;
+    long long b = 0;
+    long long c = 0;
+
+    (void)self;
+    if (!PyArg_ParseTuple(args, "i|LLL:call_float", &opcode, &a, &b, &c)) {
+        return NULL;
+    }
+
+    return PyFloat_FromDouble(cosmos_host_call_float(opcode, a, b, c));
+}
+
+static PyMethodDef cosmos_methods[] = {
+    {"call", cosmos_call, METH_VARARGS, NULL},
+    {"call_float", cosmos_call_float, METH_VARARGS, NULL},
+    {NULL, NULL, 0, NULL},
+};
+
+static struct PyModuleDef cosmos_module = {
+    PyModuleDef_HEAD_INIT,
+    "_cosmos",
+    NULL,
+    -1,
+    cosmos_methods,
+};
+
+PyMODINIT_FUNC PyInit__cosmos(void) {
+    return PyModule_Create(&cosmos_module);
+}
+
+int cosmos_register_module(void) {
+    return PyImport_AppendInittab("_cosmos", PyInit__cosmos);
+}
+
+__attribute__((export_name("cosmos_turn")))
+int32_t cosmos_turn(void) {
+    PyObject *main_module = PyImport_AddModule("__main__");
+    PyObject *turn;
+    PyObject *result;
+
+    if (main_module == NULL) {
+        PyErr_Clear();
+        return 1;
+    }
+
+    turn = PyObject_GetAttrString(main_module, "__cosmos_turn");
+    if (turn == NULL || !PyCallable_Check(turn)) {
+        Py_XDECREF(turn);
+        PyErr_Clear();
+        return 2;
+    }
+
+    result = PyObject_CallNoArgs(turn);
+    Py_DECREF(turn);
+    if (result == NULL) {
+        PyErr_Clear();
+        return 3;
+    }
+
+    Py_DECREF(result);
+    return 0;
+}
